# Required to enable anonymous analytics and feedback.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Required to enable "Open full PageFlow". No production URL was discoverable
# in the reference repository, so the app intentionally does not invent one.
VITE_MAIN_SITE_URL=https://YOUR_PAGEFLOW_PRODUCTION_URL
